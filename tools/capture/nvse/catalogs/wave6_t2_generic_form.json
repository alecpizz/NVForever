            "ref rB = GetFormFromMod \"FalloutNV.esm\" \"421C\"",
            "ref rC = GetFormFromMod \"FalloutNV.esm\" \"15169\"",
            "ref rD = GetFormFromMod \"FalloutNV.esm\" \"434F\"",
            "int a0 = GenericAddForm 13 rL rA 0",
            "int a1 = GenericAddForm 13 rL rB 1",
