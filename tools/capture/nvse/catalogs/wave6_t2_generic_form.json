            "ref dM2 = GenericDeleteForm 13 rL -2",
            "int dM2B = (dM2 == rB)",
            "int dM2C = (dM2 == rC)",
            "int nEnd = ListGetCount rL",
            "PrintToConsole \"PROBE|w6t2p3_25_generic_form_real_flst|add(%g,%g,%g,n=%g,past=%g)|delM1(h=%g,t=%g)|delM2(b=%g,c=%g)|nEnd=%g\" a0 a1 a2 n3 aPast dM1H dM1T dM2B dM2C nEnd"
