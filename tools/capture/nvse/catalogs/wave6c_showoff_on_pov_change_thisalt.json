              "Player.AuxVarSetFlt \"*p2_03_arg\" i1st",
              "Player.AuxVarSetFlt \"*p2_03_cur\" cur",
              "Player.AuxVarSetFlt \"*p2_03_s0\" (rS == 0)",
              "Player.AuxVarSetFlt \"*p2_03_sP\" (rS == Player)"
            ]
          },
          "extra_steps": [
            {
              "suffix": "to1p",
              "wait_ticks": 2,
              "script_lines": [
                "Player.AuxVarSetFlt \"*p2_03_n1\" (Player.AuxVarGetFlt \"*p2_03_n\")",
                "Player.AuxVarSetFlt \"*p2_03_a1\" (Player.AuxVarGetFlt \"*p2_03_arg\")",
                "Player.AuxVarSetFlt \"*p2_03_c1\" (Player.AuxVarGetFlt \"*p2_03_cur\")",
                "Player.AuxVarSetFlt \"*p2_03_aft1\" (IsPC1stPerson)",
                "Player.AuxVarSetFlt \"*p2_03_s01\" (Player.AuxVarGetFlt \"*p2_03_s0\")",
                "Player.AuxVarSetFlt \"*p2_03_sP1\" (Player.AuxVarGetFlt \"*p2_03_sP\")",
                "ToggleFirstPerson 1"
              ]
            },
            {
              "suffix": "read",
              "wait_ticks": 0,
              "script_lines": [
                "int init = Player.AuxVarGetFlt \"*p2_03_init\"",
                "int n1 = Player.AuxVarGetFlt \"*p2_03_n1\"",
                "int a1 = Player.AuxVarGetFlt \"*p2_03_a1\"",
                "int c1 = Player.AuxVarGetFlt \"*p2_03_c1\"",
                "int aft1 = Player.AuxVarGetFlt \"*p2_03_aft1\"",
                "int s01 = Player.AuxVarGetFlt \"*p2_03_s01\"",
                "int sP1 = Player.AuxVarGetFlt \"*p2_03_sP1\"",
                "int n2 = Player.AuxVarGetFlt \"*p2_03_n\"",
                "int a2 = Player.AuxVarGetFlt \"*p2_03_arg\"",
                "int c2 = Player.AuxVarGetFlt \"*p2_03_cur\"",
                "int aft2 = IsPC1stPerson",
                "ref cb = Player.AuxVarGetRef \"*p2_03_cb\"",
                "RemoveEventHandler \"ShowOff:OnPOVChange\" cb",
                "PrintToConsole \"PROBE|w6t2p2_03_showoff_on_pov_change_toggle|init=%g|to3p(n=%g,arg=%g,inCb=%g,aft=%g,s0=%g,sP=%g)|to1p(n=%g,arg=%g,inCb=%g,aft=%g)\" init n1 a1 c1 aft1 s01 sP1 n2 a2 c2 aft2"
              ]
