          "expected": "p0=0(0.0,100.0)|p90=0(100.0,0.0)|a0=0(1000.0,2100.0)|a45=0(1070.7,2070.7)|a90=0(1100.0,2000.0)|a180=0(1000.0,1900.0)|am90=0(900.0,2000.0)",
          "script_lines": [
            "float ox = 111",
            "float oy = 222",
            "float px = Player.GetPos X",
            "float py = Player.GetPos Y",
            "int rp0 = Player.GetCalculatedPos 0 100 (ox) (oy)",
            "float p0x = ox - px",
            "float p0y = oy - py",
            "int rp90 = Player.GetCalculatedPos 90 100 (ox) (oy)",
            "float p90x = ox - px",
            "float p90y = oy - py",
            "int ra0 = GetCalculatedPosAlt 0 100 (ox) (oy) 1000 2000",
            "float a0x = ox",
            "float a0y = oy",
            "int ra45 = GetCalculatedPosAlt 45 100 (ox) (oy) 1000 2000",
            "float a45x = ox",
            "float a45y = oy",
            "int ra90 = GetCalculatedPosAlt 90 100 (ox) (oy) 1000 2000",
            "float a90x = ox",
            "float a90y = oy",
            "int ra180 = GetCalculatedPosAlt 180 100 (ox) (oy) 1000 2000",
            "float a180x = ox",
            "float a180y = oy",
            "float fM90 = -90",
            "int ram90 = GetCalculatedPosAlt fM90 100 (ox) (oy) 1000 2000",
            "string_var s1 = sv_Construct \"p0=%g(%.1f,%.1f)|p90=%g(%.1f,%.1f)|a0=%g(%.1f,%.1f)|a45=%g(%.1f,%.1f)\" rp0 p0x p0y rp90 p90x p90y ra0 a0x a0y ra45 a45x a45y",
            "string_var s2 = sv_Construct \"a90=%g(%.1f,%.1f)|a180=%g(%.1f,%.1f)|am90=%g(%.1f,%.1f)\" ra90 a90x a90y ra180 a180x a180y ram90 ox oy",
            "PrintToConsole \"PROBE|w6_t1_11_sup_calc_pos|%z|%z\" s1 s2"
          ]
        },
